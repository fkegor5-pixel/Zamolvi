<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/replyai_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/widget_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/replyai_widget_dot_off"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Zamolvi"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/replyai_widget_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Zamolvi"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/replyai_widget_ink" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:text="Нажмите «Обновить»"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/replyai_widget_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_enable"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Включить"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/replyai_widget_button_accent" />
        <TextView
            android:id="@+id/widget_disable"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="Стоп"
            android:textSize="14sp"
            android:textColor="@color/replyai_widget_ink"
            android:background="@drawable/replyai_widget_button" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="↻"
            android:contentDescription="Обновить"
            android:textSize="18sp"
            android:textColor="@color/replyai_widget_ink"
            android:background="@drawable/replyai_widget_button" />
    </LinearLayout>
</LinearLayout>
